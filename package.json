{
  "name": "scaleax-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "ScaleAX public website (apps/website) — frontend-only workspace",
  "license": "MIT",
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @scaleax/website dev",
    "build": "pnpm --filter @scaleax/website build",
    "start": "pnpm --filter @scaleax/website start",
    "lint": "pnpm --filter @scaleax/website lint",
    "test": "pnpm --filter @scaleax/website test",
    "test:unit": "pnpm --filter @scaleax/website test:unit",
    "test:e2e": "pnpm --filter @scaleax/e2e test:e2e:website",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  },
  "lint-staged": {
    "apps/website/**/*.{ts,tsx,js,jsx}": [
      "pnpm --filter @scaleax/website exec next lint --fix --file",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "next>@playwright/test": "-"
    }
  }
}
